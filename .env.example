# Django
SECRET_KEY=django-insecure-change-me-in-production-!@#$%^&*()
DEBUG=True
ALLOWED_HOSTS=*
DJANGO_SETTINGS_MODULE=config.settings.development

# Database (PostgreSQL)
DB_NAME=skill_swap
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis (Rate limiting + Cache + Channels)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email (use 'console' for dev, 'smtp' for production)
EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=vvnnbatistuta224@gmail.com
EMAIL_HOST_PASSWORD=qama trnd mmll ckxi
DEFAULT_FROM_EMAIL=vvnnbatistuta224@gmail.com

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
